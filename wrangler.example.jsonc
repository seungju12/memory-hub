// Copy to wrangler.jsonc and fill in your own IDs (wrangler.jsonc is gitignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // P3: serve only on the custom domain (set to true while you have no domain yet)
  "workers_dev": false,
  "routes": [{ "pattern": "mcp.<your-domain>", "custom_domain": true }],
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-hub",
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  // P2: embeddings (bge-m3, 1024 dims) + vector index for semantic search
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "memory-hub" }],
  // P2: embedding backfill (*/30) · P3.5: About Me snapshot sync (*/5), Memory Inbox collection (*/10)
  // Keep in sync with CRON in src/index.ts. Free plan: 5 cron triggers per account.
  "triggers": { "crons": ["*/30 * * * *", "*/5 * * * *", "*/10 * * * *"] },
  "kv_namespaces": [
    // OAuth clients, grants and tokens (hashed / encrypted by workers-oauth-provider)
    { "binding": "OAUTH_KV", "id": "<your-kv-namespace-id>" }
  ],
  "vars": {
    // Public origin used for OAuth metadata and the GitHub callback (no trailing slash)
    "PUBLIC_BASE_URL": "https://mcp.<your-domain>"
  }
  // Secrets (set with `wrangler secret put`, never commit):
  //   GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET - GitHub OAuth App (callback: <PUBLIC_BASE_URL>/callback)
  //   ALLOWED_GITHUB_USER_ID - numeric id of the only GitHub user allowed (gh api user --jq .id)
  //   MCP_TOKEN              - optional Bearer token for CLI clients (min 16 chars)
  //   NOTION_TOKEN, NOTION_ABOUT_PAGE_ID, NOTION_INBOX_DATA_SOURCE_ID - P3.5 Notion bridge (optional, see clients/pickle.md)
}
