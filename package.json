{
  "name": "memory-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Personal memory MCP server on Cloudflare Workers — one source of truth about me, shared across AI clients.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply memory-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply memory-hub --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
